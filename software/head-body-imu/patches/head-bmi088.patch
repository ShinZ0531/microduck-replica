+//! Explicit host IMU source selection; never probes or substitutes a different sensor.
+use crate::params::{TrunkImuParams, TrunkImuSource};
+use duck_control::trunk_imu::{HostImu, HostImuHealth, HostImuSample, TrunkImuKind};
+use std::io;
+
+/// One clonable reader shared by startup retries, commissioning and the control loop.
+#[derive(Clone)]
+pub enum HostReader {
+    I2c(crate::trunk_imu_i2c::TrunkImuReader),
+    Head(crate::head_imu_reader::HeadImuReader),
+}
+
+impl HostReader {
+    /// Borrow the selected source without changing sensor-frame semantics.
+    fn reader(&self) -> &dyn HostImu {
+        match self {
+            Self::I2c(reader) => reader,
+            Self::Head(reader) => reader,
+        }
+    }
+}
+
+impl HostImu for HostReader {
+    /// Report the configured hardware source.
+    fn kind(&self) -> TrunkImuKind {
+        self.reader().kind()
+    }
+    /// Take a nonblocking raw sensor snapshot.
+    fn latest(&self) -> Option<HostImuSample> {
+        self.reader().latest()
+    }
+    /// Report the worker's state and errors.
+    fn health(&self) -> HostImuHealth {
+        self.reader().health()
+    }
+    /// Only the moving-head source supplies a compensation library.
+    fn head_estimator_library(&self) -> Option<&str> {
+        self.reader().head_estimator_library()
+    }
+}
+
+/// Start exactly the configured source. The bus IMU has no separate reader.
+pub fn spawn_for(params: &TrunkImuParams) -> Option<io::Result<HostReader>> {
+    if params.source == TrunkImuSource::HeadBmi088 {
+        return Some(
+            crate::head_imu_reader::HeadImuReader::spawn(
+                &params.head_socket,
+                &params.head_estimator_library,
+            )
+            .map(HostReader::Head),
+        );
+    }
+    crate::trunk_imu_i2c::spawn_for(params).map(|result| result.map(HostReader::I2c))
+}
