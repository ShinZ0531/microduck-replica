+            /// Provide a stationary upright sample 10 ms behind the current encoder transaction.
+            fn latest(&self) -> Option<crate::trunk_imu::HostImuSample> {
+                let now = Instant::now();
+                Some(crate::trunk_imu::HostImuSample {
+                    quat: [std::f64::consts::FRAC_1_SQRT_2, 0.0, -std::f64::consts::FRAC_1_SQRT_2, 0.0],
+                    gyro: [0.0; 3], received_at: now - Duration::from_millis(10),
+                    sequence: self.sequence.fetch_add(1, Ordering::Relaxed),
+                    epoch: 1, epoch_started_at: now - Duration::from_secs(5), accuracy: None, fusion: None,
+                })
