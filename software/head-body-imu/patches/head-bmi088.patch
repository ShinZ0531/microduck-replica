--- /dev/null
+++ b/microduck-hd1910/firmware/robotd/src/head_imu_reader.rs
@@ -0,0 +1,323 @@
+//! Read the HAT BMI088 from tofd without competing for its I2C device.
+//! Source CLOCK_MONOTONIC timestamps, not socket arrival time, determine freshness.
+
+use std::io::{self, BufRead, BufReader, Write};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use arc_swap::ArcSwapOption;
+use duck_control::trunk_imu::{HostImu, HostImuHealth, HostImuSample, TrunkImuKind};
+use serde::Deserialize;
+
+/// Values transported by the existing head_imu.frame endpoint; all are sensor-frame data.
+#[derive(Deserialize)]
+struct WireSample {
+    quat: [f64; 4],
+    gyro: [f64; 3],
+    seq: u64,
+    t_ns: u64,
+}
+
+/// Single-writer snapshot and reader lifecycle shared without giving the worker self-ownership.
+struct Shared {
+    latest: ArcSwapOption<HostImuSample>,
+    stop: AtomicBool,
+    health: Mutex<HostImuHealth>,
+}
+
+/// Last owner requests worker shutdown; the 200-ms socket timeout bounds its next read.
+struct Owner {
+    shared: Arc<Shared>,
+    library: String,
+}
+
+impl Drop for Owner {
+    /// Stop the worker when the last controller owner releases it.
+    fn drop(&mut self) {
+        self.shared.stop.store(true, Ordering::Relaxed);
+    }
+}
+
+/// Cheap cloned handles survive controller startup retries; one worker owns the socket.
+#[derive(Clone)]
+pub struct HeadImuReader(Arc<Owner>);
+
+impl HeadImuReader {
+    /// Start a bounded reconnecting worker; a missing tofd is a reported fault, never fake data.
+    pub fn spawn(socket: &str, library: &str) -> io::Result<Self> {
+        let shared = Arc::new(Shared {
+            latest: ArcSwapOption::empty(),
+            stop: AtomicBool::new(false),
+            health: Mutex::new(HostImuHealth {
+                state: "connecting",
+                ..HostImuHealth::default()
+            }),
+        });
+        let worker = shared.clone();
+        let socket = socket.to_owned();
+        std::thread::Builder::new()
+            .name("head-bmi088".into())
+            .spawn(move || run(worker, socket))?;
+        Ok(Self(Arc::new(Owner {
+            shared,
+            library: library.to_owned(),
+        })))
+    }
+}
+
+impl HostImu for HeadImuReader {
+    /// Distinguish a moving head sensor from fixed-body I2C modules in every diagnostic.
+    fn kind(&self) -> TrunkImuKind {
+        TrunkImuKind::HeadBmi088
+    }
+
+    /// Return raw sensor data; consumers must apply measured head encoder compensation.
+    fn latest(&self) -> Option<HostImuSample> {
+        self.0.shared.latest.load_full().map(|sample| *sample)
+    }
+
+    /// Health snapshots never wait behind a worker updating counters.
+    fn health(&self) -> HostImuHealth {
+        self.0
+            .shared
+            .health
+            .try_lock()
+            .map(|health| health.clone())
+            .unwrap_or_else(|_| HostImuHealth {
+                state: "updating",
+                ..HostImuHealth::default()
+            })
+    }
+
+    /// The immutable ABI-v1 core loaded by each consumer, outside the control loop.
+    fn head_estimator_library(&self) -> Option<&str> {
+        Some(&self.0.library)
+    }
+}
+
+/// Map tofd's monotonic source clock onto Instant while rejecting future and stale frames.
+fn source_instant(source_ns: u64, clock_ns: u64, now: Instant) -> io::Result<Instant> {
+    let age = clock_ns
+        .checked_sub(source_ns)
+        .filter(|age| *age <= 50_000_000)
+        .ok_or_else(|| {
+            io::Error::new(
+                io::ErrorKind::InvalidData,
+                "head sample future or older than 50 ms",
+            )
+        })?;
+    now.checked_sub(Duration::from_nanos(age))
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidData, "invalid source clock"))
+}
+
+/// Retry independently of the controller tick; each reconnect clears the last sample.
+fn run(shared: Arc<Shared>, socket: String) {
+    let mut epoch = 0u32;
+    while !shared.stop.load(Ordering::Relaxed) {
+        epoch = epoch.wrapping_add(1);
+        shared.latest.store(None);
+        if let Ok(mut health) = shared.health.lock() {
+            health.state = "connecting";
+            health.epoch = epoch;
+        }
+        if let Err(error) = stream(&shared, &socket, epoch) {
+            shared.latest.store(None);
+            if let Ok(mut health) = shared.health.lock() {
+                health.state = "reconnecting";
+                health.errors += 1;
+                health.last_error = Some(error.to_string());
+            }
+        }
+        for _ in 0..10 {
+            if shared.stop.load(Ordering::Relaxed) {
+                break;
+            }
+            std::thread::sleep(Duration::from_millis(50));
+        }
+    }
+    shared.latest.store(None);
+}
+
+/// Read newline JSON with a 64-KiB cap. A faulty writer cannot grow the buffer indefinitely.
+fn bounded_line(reader: &mut impl BufRead) -> io::Result<Vec<u8>> {
+    let mut line = Vec::with_capacity(1024);
+    loop {
+        let available = reader.fill_buf()?;
+        if available.is_empty() {
+            return Err(io::Error::new(
+                io::ErrorKind::UnexpectedEof,
+                "tofd disconnected",
+            ));
+        }
+        let count = available
+            .iter()
+            .position(|b| *b == b'\n')
+            .map_or(available.len(), |i| i + 1);
+        if line.len() + count > 65536 {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "tofd frame exceeds 64 KiB",
+            ));
+        }
+        line.extend_from_slice(&available[..count]);
+        reader.consume(count);
+        if line.last() == Some(&b'\n') {
+            return Ok(line);
+        }
+    }
+}
+
+/// Subscribe to the existing BMI088 stream. A timeout reconnects and creates a fresh epoch.
+#[cfg(unix)]
+fn stream(shared: &Shared, socket: &str, epoch: u32) -> io::Result<()> {
+    let mut socket = std::os::unix::net::UnixStream::connect(socket)?;
+    socket.set_read_timeout(Some(Duration::from_millis(200)))?;
+    socket.set_write_timeout(Some(Duration::from_millis(200)))?;
+    socket.write_all(
+        b"{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"head_imu.stream\",\"params\":{}}\n",
+    )?;
+    let mut reader = BufReader::new(socket);
+    let epoch_started_at = Instant::now();
+    let mut last_source_ns = None;
+    let mut last_sequence = None;
+    let mut accepted = false;
+    while !shared.stop.load(Ordering::Relaxed) {
+        let line = bounded_line(&mut reader)?;
+        let message: serde_json::Value = serde_json::from_slice(&line)?;
+        if message.get("id") == Some(&serde_json::json!(1)) {
+            accepted =
+                message["result"]["accepted"] == true && message["result"]["sensor"] == "BMI088";
+            if !accepted {
+                return Err(io::Error::other(format!(
+                    "tofd refused BMI088 subscription: {message}"
+                )));
+            }
+            continue;
+        }
+        if !accepted || message["method"] != "head_imu.frame" {
+            continue;
+        }
+        let wire: WireSample = serde_json::from_value(message["params"].clone())?;
+        if last_source_ns.is_some_and(|last| wire.t_ns <= last)
+            || last_sequence.is_some_and(|last| wire.seq <= last)
+        {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "head IMU source sequence or clock restarted",
+            ));
+        }
+        let now = Instant::now();
+        let clock_ns = duck_ipc_proto::clock::monotonic_ns();
+        let received_at = source_instant(wire.t_ns, clock_ns, now)?;
+        let norm = wire.quat.iter().map(|value| value * value).sum::<f64>();
+        if !norm.is_finite()
+            || !(0.9..=1.1).contains(&norm)
+            || wire.gyro.iter().any(|value| !value.is_finite())
+        {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "head IMU invalid quaternion or gyro",
+            ));
+        }
+        last_source_ns = Some(wire.t_ns);
+        last_sequence = Some(wire.seq);
+        shared.latest.store(Some(Arc::new(HostImuSample {
+            quat: wire.quat,
+            gyro: wire.gyro,
+            received_at,
+            sequence: wire.seq as u32,
+            epoch,
+            epoch_started_at,
+            accuracy: None,
+            fusion: None,
+        })));
+        if let Ok(mut health) = shared.health.lock() {
+            health.state = "streaming";
+            health.samples += 1;
+            health.last_error = None;
+        }
+    }
+    Ok(())
+}
+
+/// Non-Unix hosts can compile diagnostics but cannot attach to the board's Unix socket.
+#[cfg(not(unix))]
+fn stream(_shared: &Shared, _socket: &str, _epoch: u32) -> io::Result<()> {
+    Err(io::Error::new(
+        io::ErrorKind::Unsupported,
+        "head BMI088 requires a Unix socket",
+    ))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Arrival time must not revive buffered or future source data.
+    #[test]
+    fn source_clock_rejects_stale_and_future_samples() {
+        let now = Instant::now();
+        assert_eq!(
+            source_instant(90_000_000, 100_000_000, now).unwrap(),
+            now - Duration::from_millis(10)
+        );
+        assert!(source_instant(49_999_999, 100_000_000, now).is_err());
+        assert!(source_instant(100_000_001, 100_000_000, now).is_err());
+    }
+
+    /// Missing delimiters remain bounded, and split frames retain exact bytes.
+    #[test]
+    fn socket_lines_are_bounded() {
+        assert_eq!(bounded_line(&mut &b"abc\nnext\n"[..]).unwrap(), b"abc\n");
+        assert!(bounded_line(&mut &vec![b'x'; 65537][..]).is_err());
+        assert!(bounded_line(&mut &b"partial"[..]).is_err());
+    }
+
+    /// Exercise the real socket worker and source-time mapping without an I2C or servo device.
+    #[test]
+    #[cfg(unix)]
+    fn worker_reads_the_existing_tofd_wire_protocol() {
+        let directory = tempfile::tempdir().unwrap();
+        let path = directory.path().join("tof.sock");
+        let listener = std::os::unix::net::UnixListener::bind(&path).unwrap();
+        let done = Arc::new(AtomicBool::new(false));
+        let server_done = done.clone();
+        let server = std::thread::spawn(move || {
+            let (mut stream, _) = listener.accept().unwrap();
+            stream
+                .set_write_timeout(Some(Duration::from_secs(1)))
+                .unwrap();
+            let mut request = BufReader::new(stream.try_clone().unwrap());
+            let message: serde_json::Value =
+                serde_json::from_slice(&bounded_line(&mut request).unwrap()).unwrap();
+            assert_eq!(message["method"], "head_imu.stream");
+            writeln!(stream, "{}", serde_json::json!({"jsonrpc":"2.0","id":1,"result":{"accepted":true,"sensor":"BMI088","hz":50}})).unwrap();
+            let mut sequence = 0u64;
+            while !server_done.load(Ordering::Relaxed) {
+                sequence += 1;
+                let frame = serde_json::json!({"jsonrpc":"2.0","method":"head_imu.frame","params":{
+                    "seq":sequence,"t_ns":duck_ipc_proto::clock::monotonic_ns(),
+                    "quat":[1.0,0.0,0.0,0.0],"gyro":[0.01,0.02,0.03]}});
+                if writeln!(stream, "{frame}").is_err() {
+                    break;
+                }
+                std::thread::sleep(Duration::from_millis(20));
+            }
+        });
+        let reader = HeadImuReader::spawn(path.to_str().unwrap(), "/test/not-loaded.so").unwrap();
+        let deadline = Instant::now() + Duration::from_secs(2);
+        while reader.health().samples < 3 && Instant::now() < deadline {
+            std::thread::sleep(Duration::from_millis(10));
+        }
+        let observed = reader.latest();
+        done.store(true, Ordering::Relaxed);
+        drop(reader);
+        server.join().unwrap();
+        let observed = observed.expect("worker must publish real source frames");
+        assert!(observed.sequence >= 3);
+        assert_eq!(observed.quat, [1.0, 0.0, 0.0, 0.0]);
+        assert_eq!(observed.gyro, [0.01, 0.02, 0.03]);
+        assert!(Instant::now().duration_since(observed.received_at) < Duration::from_millis(100));
+    }
+}
