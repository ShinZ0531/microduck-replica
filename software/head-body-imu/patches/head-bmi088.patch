new file mode 100644
--- /dev/null
+++ b/microduck-hd1910/firmware/duck-control/src/head_compensation.rs
@@ -0,0 +1,343 @@
+//! Moving-head BMI088 adapter. Encoder history is local to each control consumer;
+//! the separately versioned C++ core owns the kinematics and timestamp checks.
+//! No successful estimate grants motion permission: Calibration remains authoritative.
+
+use std::collections::VecDeque;
+use std::time::Instant;
+
+use crate::feetech::{Calibration, ServoSample};
+use crate::io::{IoError, Result};
+use crate::trunk_imu::{HostImu, HostImuSample, TrunkImuKind};
+
+const HEAD_IDS: [u8; 4] = [30, 31, 32, 33];
+
+/// ABI v1 input, matching head_body_estimator.h; units are radians and monotonic ns.
+#[repr(C)]
+#[derive(Default)]
+struct HeadInput {
+    version: u32,
+    mount_verified: u32,
+    joints_verified: u32,
+    reserved: u32,
+    now_ns: u64,
+    imu_ns: u64,
+    joint_ns: u64,
+    velocity_ns: u64,
+    quat: [f64; 4],
+    gyro: [f64; 3],
+    angles: [f64; 4],
+    velocities: [f64; 4],
+    sensor_to_site: [f64; 4],
+}
+
+/// ABI v1 output; status and availability must be checked before using any numbers.
+#[repr(C)]
+#[derive(Default)]
+struct BodyEstimate {
+    version: u32,
+    status: u32,
+    available: u32,
+    motion_authorized: u32,
+    quat: [f64; 4],
+    gyro: [f64; 3],
+    gravity: [f64; 3],
+    sensor_to_body: [f64; 4],
+    relative_gyro: [f64; 3],
+}
+
+/// Two complete, measured head encoder packets bracketing the IMU sample.
+#[repr(C)]
+#[derive(Default)]
+struct EncoderPair {
+    previous: [i32; 4],
+    current: [i32; 4],
+    direction: [i32; 4],
+    zero: [i32; 4],
+    previous_ns: u64,
+    current_ns: u64,
+}
+
+type Estimate =
+    unsafe extern "C" fn(*const HeadInput, *const EncoderPair, *mut BodyEstimate) -> i32;
+
+/// A complete head encoder observation, timestamped after its bus transaction.
+struct EncoderFrame {
+    at: Instant,
+    raw: [i32; 4],
+}
+
+/// Bounded history plus a loaded, immutable ABI-v1 library. No socket or bus ownership.
+pub struct HeadCompensation {
+    // Keep the code mapped until after the function pointer is no longer usable.
+    _library: libloading::Library,
+    estimate: Estimate,
+    origin: Instant,
+    history: VecDeque<EncoderFrame>,
+}
+
+/// Preserve the controller's existing IMU-failure classification.
+fn refused(reason: impl std::fmt::Display) -> IoError {
+    IoError::Bus(format!(
+        "Feetech IMU not ready or stale (head_bmi088: {reason})"
+    ))
+}
+
+impl HeadCompensation {
+    /// Load once for this consumer; other IMU sources do not load the head library.
+    pub fn for_reader(reader: &dyn HostImu) -> Result<Option<Self>> {
+        if reader.kind() != TrunkImuKind::HeadBmi088 {
+            return Ok(None);
+        }
+        let path = reader
+            .head_estimator_library()
+            .ok_or_else(|| refused("missing estimator library path"))?;
+        // The path comes from explicit local configuration, never a network sample.
+        let library = unsafe { libloading::Library::new(path) }.map_err(refused)?;
+        let estimate = unsafe {
+            *library
+                .get::<Estimate>(b"microduck_estimate_encoders\0")
+                .map_err(refused)?
+        };
+        Ok(Some(Self {
+            _library: library,
+            estimate,
+            origin: Instant::now(),
+            history: VecDeque::with_capacity(8),
+        }))
+    }
+
+    /// Keep a complete packet only. Missing head joints invalidate the interpolation history.
+    pub fn observe<'a>(
+        &mut self,
+        samples: impl Iterator<Item = (u8, &'a ServoSample)>,
+        at: Instant,
+    ) -> Result<()> {
+        let mut raw = [None; 4];
+        for (id, sample) in samples {
+            if let Some(index) = HEAD_IDS.iter().position(|head_id| *head_id == id) {
+                raw[index] = Some(sample.feedback.position_raw);
+            }
+        }
+        if raw.iter().any(Option::is_none) {
+            self.history.clear();
+            return Err(refused("incomplete head encoder packet"));
+        }
+        if self
+            .history
+            .back()
+            .is_some_and(|previous| at <= previous.at)
+        {
+            self.history.clear();
+            return Err(refused("non-increasing encoder timestamp"));
+        }
+        if self.history.len() == 8 {
+            self.history.pop_front();
+        }
+        self.history.push_back(EncoderFrame {
+            at,
+            raw: raw.map(Option::unwrap),
+        });
+        Ok(())
+    }
+
+    /// Interpolate measured encoders around the source-clock IMU sample, never extrapolate.
+    /// Unverified calibration permits a diagnostic estimate but cannot pass motion startup.
+    pub fn compensate(
+        &self,
+        sample: Option<HostImuSample>,
+        calibration: &Calibration,
+        now: Instant,
+    ) -> Result<HostImuSample> {
+        let mut sample = sample.ok_or_else(|| refused("no head IMU sample"))?;
+        let (previous, current) = self
+            .history
+            .iter()
+            .zip(self.history.iter().skip(1))
+            .find(|(a, b)| a.at <= sample.received_at && sample.received_at <= b.at)
+            .ok_or_else(|| refused("waiting for encoder packets around IMU timestamp"))?;
+        let ns = |at: Instant| -> Result<u64> {
+            at.checked_duration_since(self.origin)
+                .and_then(|duration| u64::try_from(duration.as_nanos()).ok())
+                .ok_or_else(|| refused("sample predates encoder history"))
+        };
+        let mount = calibration.imu_mount(TrunkImuKind::HeadBmi088);
+        let mut pair = EncoderPair {
+            previous: previous.raw,
+            current: current.raw,
+            previous_ns: ns(previous.at)?,
+            current_ns: ns(current.at)?,
+            ..EncoderPair::default()
+        };
+        let mut joints_verified = true;
+        for (index, id) in HEAD_IDS.iter().enumerate() {
+            let joint = calibration
+                .joints
+                .iter()
+                .find(|joint| joint.id == *id)
+                .ok_or_else(|| refused(format!("head joint ID {id} missing from calibration")))?;
+            pair.direction[index] = i32::from(joint.direction);
+            pair.zero[index] = i32::from(joint.zero_raw);
+            joints_verified &= joint.calibrated;
+        }
+        let input = HeadInput {
+            version: 1,
+            mount_verified: u32::from(mount.verified),
+            joints_verified: u32::from(joints_verified),
+            now_ns: ns(now)?,
+            imu_ns: ns(sample.received_at)?,
+            quat: sample.quat,
+            gyro: sample.gyro,
+            sensor_to_site: mount.quat,
+            ..HeadInput::default()
+        };
+        let mut output = BodyEstimate::default();
+        // POD layout is pinned by tests; the core has no IO, allocation or exceptions.
+        let status = unsafe { (self.estimate)(&input, &pair, &mut output) };
+        if !matches!(status, 0 | 1)
+            || output.version != 1
+            || output.available != 1
+            || output.status != status as u32
+            || output.motion_authorized != 0
+            || output
+                .quat
+                .iter()
+                .chain(output.gyro.iter())
+                .any(|v| !v.is_finite())
+        {
+            return Err(refused(format!(
+                "compensation refused, core status {status}"
+            )));
+        }
+        sample.quat = output.quat;
+        sample.gyro = output.gyro;
+        sample.fusion = None;
+        Ok(sample)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::trunk_imu::HostImuHealth;
+    use std::time::Duration;
+
+    /// Raw provider used only for the real-library ABI integration test.
+    struct TestReader(String);
+    impl HostImu for TestReader {
+        /// Select the moving-head source.
+        fn kind(&self) -> TrunkImuKind {
+            TrunkImuKind::HeadBmi088
+        }
+        /// Tests supply deterministic samples directly.
+        fn latest(&self) -> Option<HostImuSample> {
+            None
+        }
+        /// No background worker is involved in these tests.
+        fn health(&self) -> HostImuHealth {
+            HostImuHealth::default()
+        }
+        /// Use the separately compiled and verified host library.
+        fn head_estimator_library(&self) -> Option<&str> {
+            Some(&self.0)
+        }
+    }
+
+    /// Catch ABI drift before an ARM build is allowed to use the existing C++ library.
+    #[test]
+    fn layouts_match_cpp_abi_v1() {
+        assert_eq!(std::mem::size_of::<HeadInput>(), 200);
+        assert_eq!(std::mem::size_of::<EncoderPair>(), 80);
+        assert_eq!(std::mem::size_of::<BodyEstimate>(), 152);
+        assert_eq!(std::mem::offset_of!(HeadInput, quat), 48);
+        assert_eq!(std::mem::offset_of!(HeadInput, sensor_to_site), 168);
+        assert_eq!(std::mem::offset_of!(BodyEstimate, quat), 16);
+    }
+
+    /// Exercise the actual FFI and reject old data, extrapolation, missing packets and bad axes.
+    #[test]
+    #[ignore = "requires MICRODUCK_HEAD_CORE_TEST_LIB pointing to the host ABI-v1 library"]
+    fn cpp_core_is_used_with_bracketed_encoders_and_motion_stays_gated() {
+        let reader =
+            TestReader(std::env::var("MICRODUCK_HEAD_CORE_TEST_LIB").expect("test library path"));
+        let mut head = HeadCompensation::for_reader(&reader).unwrap().unwrap();
+        let origin = head.origin;
+        head.history.push_back(EncoderFrame {
+            at: origin + Duration::from_millis(10),
+            raw: [2048; 4],
+        });
+        head.history.push_back(EncoderFrame {
+            at: origin + Duration::from_millis(30),
+            raw: [2048; 4],
+        });
+        let mut calibration = Calibration::commissioning(crate::model::JOINT_IDS);
+        let sample = HostImuSample {
+            quat: [
+                std::f64::consts::FRAC_1_SQRT_2,
+                0.0,
+                -std::f64::consts::FRAC_1_SQRT_2,
+                0.0,
+            ],
+            gyro: [0.0; 3],
+            received_at: origin + Duration::from_millis(20),
+            sequence: 7,
+            epoch: 1,
+            epoch_started_at: origin,
+            accuracy: None,
+            fusion: None,
+        };
+        let body = head
+            .compensate(
+                Some(sample),
+                &calibration,
+                origin + Duration::from_millis(31),
+            )
+            .unwrap();
+        assert!((body.quat[0].abs() - 1.0).abs() < 1e-10);
+        assert!(body.quat[1..].iter().all(|value| value.abs() < 1e-10));
+        assert_eq!(body.gyro, [0.0; 3]);
+        assert_eq!(body.received_at, sample.received_at);
+        assert!(
+            calibration
+                .validate_motion_for(TrunkImuKind::HeadBmi088)
+                .is_err()
+        );
+        assert!(
+            head.compensate(
+                Some(sample),
+                &calibration,
+                origin + Duration::from_millis(80)
+            )
+            .is_err()
+        );
+        assert!(
+            head.compensate(
+                Some(HostImuSample {
+                    received_at: origin + Duration::from_millis(31),
+                    ..sample
+                }),
+                &calibration,
+                origin + Duration::from_millis(32)
+            )
+            .is_err()
+        );
+        calibration
+            .joints
+            .iter_mut()
+            .find(|joint| joint.id == 30)
+            .unwrap()
+            .direction = 0;
+        assert!(
+            head.compensate(
+                Some(sample),
+                &calibration,
+                origin + Duration::from_millis(31)
+            )
+            .is_err()
+        );
+        assert!(
+            head.observe(std::iter::empty(), origin + Duration::from_millis(40))
+                .is_err()
+        );
+        assert!(head.history.is_empty());
+    }
+}
