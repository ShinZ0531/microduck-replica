--- /dev/null
+++ b/microduck-hd1910/firmware/robotd/src/head_imu_standing.rs
@@ -0,0 +1,380 @@
+//! 通电站姿下的头部核验调度；串口目标仍只由 commissioning 的 Hold 写入。
+use super::*;
+
+const PAGE_LEASE: Duration = Duration::from_millis(2500);
+const STEP_TIMEOUT: Duration = Duration::from_secs(60);
+const PREPARE_TIME: Duration = Duration::from_secs(3);
+const CAPTURE_INTERVAL: Duration = Duration::from_millis(200);
+const SWEEP_TIME: Duration = Duration::from_secs(8);
+const SWEEP_COUNTS: i32 = 57; // 4096 count/rev，约 ±5°；不使用网页传入的幅度。
+
+/// 有界单关节轨迹，中心来自已稳定的站姿目标；不改其他十四颗目标。
+#[derive(Clone)]
+struct Sweep {
+    index: usize,
+    id: u8,
+    from: i32,
+    center: i32,
+    started: Instant,
+}
+
+impl Sweep {
+    /// 连续经过 +5°、-5°、中心；每段线性慢速，最后一段回中心。
+    fn target(&self, now: Instant) -> i32 {
+        let seconds = now.saturating_duration_since(self.started).as_secs_f64();
+        let (from, to, fraction) = if seconds < 2.0 {
+            (self.from, self.center + SWEEP_COUNTS, seconds / 2.0)
+        } else if seconds < 6.0 {
+            (
+                self.center + SWEEP_COUNTS,
+                self.center - SWEEP_COUNTS,
+                (seconds - 2.0) / 4.0,
+            )
+        } else {
+            (
+                self.center - SWEEP_COUNTS,
+                self.center,
+                ((seconds - 6.0) / 2.0).min(1.0),
+            )
+        };
+        (f64::from(from) + f64::from(to - from) * fraction).round() as i32
+    }
+}
+
+/// 同一主控循环独占几何会话、采集进度、页面租约与当前轨迹；暂停保留已通过步骤。
+pub(super) struct StandingCalibration {
+    pub core: duck_control::head_calibration::Session,
+    running: bool,
+    testing: bool,
+    next_step: u32,
+    heartbeat: Instant,
+    not_before: Instant,
+    step_started: Instant,
+    attempted: Instant,
+    sweep: Option<Sweep>,
+    centers: Vec<i32>,
+    message: String,
+}
+
+impl StandingCalibration {
+    /// 只在已有 HOME 保持就绪且头颈方向与持久配置一致时创建，不自动使能电机。
+    pub fn new(library: &str, calibration: &Calibration, hold: &Hold) -> Result<Self, String> {
+        if hold.stage != HoldStage::Holding {
+            return Err("先等待通电站姿保持完成".into());
+        }
+        for id in [30, 31, 32, 33] {
+            let index = JOINT_IDS
+                .iter()
+                .position(|value| *value == id)
+                .ok_or("头颈 ID 缺失")?;
+            let joint = calibration
+                .joints
+                .iter()
+                .find(|joint| joint.id == id)
+                .ok_or("头颈配置缺失")?;
+            if hold.directions.get(index) != Some(&joint.direction) {
+                return Err(format!(
+                    "ID{id} 的站姿方向与主控保存方向不一致，请先核对方向配置"
+                ));
+            }
+            // 允许无历史限位的 commissioning，但测试只能围绕既有 HOME 小幅运动。
+            for raw in [
+                hold.targets[index] - SWEEP_COUNTS,
+                hold.targets[index] + SWEEP_COUNTS,
+            ] {
+                let angle = f64::from(raw - i32::from(joint.zero_raw))
+                    * f64::from(joint.direction)
+                    * std::f64::consts::TAU
+                    / 4096.0;
+                if !(0..=4095).contains(&raw)
+                    || joint.min_rad.is_some_and(|minimum| angle < minimum)
+                    || joint.max_rad.is_some_and(|maximum| angle > maximum)
+                {
+                    return Err(format!("ID{id} 的 ±5° 测试超出已有范围，不开始测试"));
+                }
+            }
+        }
+        let now = Instant::now();
+        Ok(Self {
+            core: duck_control::head_calibration::Session::new(library, calibration)?,
+            running: true,
+            testing: false,
+            next_step: 0,
+            heartbeat: now,
+            not_before: now + PREPARE_TIME,
+            step_started: now,
+            attempted: now,
+            sweep: None,
+            centers: hold.targets.clone(),
+            message: "站姿保持，准备采集静止基准".into(),
+        })
+    }
+
+    /// 供主控安全重启门槛查询；采集或测试运行时不允许更新器重启。
+    pub fn running(&self) -> bool {
+        self.running
+    }
+
+    /// 前台状态请求续租；读取本身不采集、不推进、不启动轨迹。
+    pub fn status(&mut self) -> Result<Value, String> {
+        self.heartbeat = Instant::now();
+        let mut status = self.core.capture(0, false)?;
+        status["active"] = json!(true);
+        status["running"] = json!(self.running);
+        status["testing"] = json!(self.testing);
+        status["message"] = json!(self.message);
+        status["countdown_s"] = json!(
+            self.not_before
+                .saturating_duration_since(Instant::now())
+                .as_secs_f64()
+                .ceil()
+        );
+        status["test_joint"] = self
+            .sweep
+            .as_ref()
+            .map_or(Value::Null, |sweep| json!(sweep.id));
+        Ok(status)
+    }
+
+    /// 显式开始桌面站姿自动测试，或重试当前阶段；三秒准备后才产生目标变化。
+    pub fn resume(&mut self, testing: bool) -> Result<(), String> {
+        if self.running {
+            return Err("采集或测试正在运行，请先停止".into());
+        }
+        if testing != (self.next_step >= 5) || self.next_step >= 10 {
+            return Err("请按当前阶段操作，不可跳过整机采集或重复已完成测试".into());
+        }
+        self.testing = testing;
+        self.running = true;
+        self.heartbeat = Instant::now();
+        self.not_before = self.heartbeat + PREPARE_TIME;
+        self.step_started = self.heartbeat;
+        self.message = "请保持鸭子站在桌面上，等待倒计时".into();
+        Ok(())
+    }
+
+    /// 停止轨迹并把当前测试关节目标冻结在实测位置；身体仍由原 Hold 保持，不自动回中心。
+    pub fn pause(
+        &mut self,
+        hold: Option<&mut Hold>,
+        samples: &BTreeMap<u8, ServoSample>,
+        reason: &str,
+    ) {
+        if let (Some(sweep), Some(hold)) = (self.sweep.take(), hold) {
+            if let Some(sample) = samples.get(&sweep.id) {
+                hold.targets[sweep.index] = i32::from(sample.feedback.position_raw);
+            }
+        }
+        self.running = false;
+        self.message = reason.into();
+    }
+
+    /// 成功读数后的唯一调度入口；故障或租约过期会停止，不因轮询自动恢复。
+    pub fn tick(
+        &mut self,
+        hold: Option<&mut Hold>,
+        samples: &BTreeMap<u8, ServoSample>,
+        now: Instant,
+    ) {
+        let Some(hold) = hold else {
+            self.pause(None, samples, "站姿保持已结束，测试停止；重新站稳后再开始");
+            return;
+        };
+        if !self.running {
+            return;
+        }
+        if now.saturating_duration_since(self.heartbeat) > PAGE_LEASE {
+            self.pause(
+                Some(hold),
+                samples,
+                "页面已离开或连接中断，采集停止，站姿保持未解除",
+            );
+            return;
+        }
+        if now.saturating_duration_since(self.step_started) > STEP_TIMEOUT {
+            self.pause(
+                Some(hold),
+                samples,
+                "当前步骤超过一分钟，已停止；调整后重试当前步骤",
+            );
+            return;
+        }
+        if now < self.not_before {
+            return;
+        }
+        if let Err(error) = self.core.require_fresh() {
+            self.pause(Some(hold), samples, &error);
+            return;
+        }
+        if self.testing && self.next_step >= 6 {
+            if self.sweep.is_none() {
+                let id = 30 + (self.next_step - 6) as u8;
+                let index = JOINT_IDS.iter().position(|value| *value == id).unwrap();
+                let Some(sample) = samples.get(&id) else {
+                    self.pause(Some(hold), samples, "缺少当前头颈关节反馈，测试停止");
+                    return;
+                };
+                self.sweep = Some(Sweep {
+                    id,
+                    index,
+                    from: i32::from(sample.feedback.position_raw),
+                    center: self.centers[index],
+                    started: now,
+                });
+            }
+            let sweep = self.sweep.as_ref().unwrap();
+            if (i32::from(samples[&sweep.id].feedback.position_raw) - hold.targets[sweep.index])
+                .abs()
+                > 34
+            {
+                self.pause(
+                    Some(hold),
+                    samples,
+                    "测试关节跟随误差超过 3°，已停止；检查干涉和舵机反馈",
+                );
+                return;
+            }
+            hold.targets[sweep.index] = sweep.target(now);
+            self.message = format!("自动测试 ID{}，请保持机身站稳；不要手动掰头部", sweep.id);
+            if now.saturating_duration_since(sweep.started) < SWEEP_TIME {
+                return;
+            }
+        }
+        if now.saturating_duration_since(self.attempted) < CAPTURE_INTERVAL {
+            return;
+        }
+        self.attempted = now;
+        match self.core.capture(self.next_step, true) {
+            Err(error) => {
+                if self.sweep.is_some() {
+                    self.pause(Some(hold), samples, &error);
+                } else {
+                    self.message = error;
+                }
+            }
+            Ok(status) => {
+                self.next_step = status["next_step"].as_u64().unwrap() as u32;
+                self.sweep = None;
+                self.step_started = now;
+                self.not_before = now
+                    + if self.testing {
+                        PREPARE_TIME
+                    } else {
+                        Duration::ZERO
+                    };
+                self.message = "这一步已采好，请按下一步提示操作".into();
+                if self.next_step == 5 || self.next_step == 10 {
+                    self.running = false;
+                    self.message = if self.next_step == 5 {
+                        "整机采集通过。请放回桌面保持站立，再明确开始自动头部测试。"
+                    } else {
+                        "头部测试完成。请单独确认保存，当前仍保持通电站姿。"
+                    }
+                    .into();
+                }
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// 确认自动轨迹连续、有界、按时回中心；只比较原始 count，不创建串口。
+    #[test]
+    fn sweep_is_slow_bounded_and_returns_to_standing_center() {
+        let start = Instant::now();
+        let sweep = Sweep {
+            index: 0,
+            id: 30,
+            from: 2048,
+            center: 2048,
+            started: start,
+        };
+        assert_eq!(sweep.target(start), 2048);
+        assert_eq!(sweep.target(start + Duration::from_secs(2)), 2105);
+        assert_eq!(sweep.target(start + Duration::from_secs(6)), 1991);
+        assert_eq!(sweep.target(start + SWEEP_TIME), 2048);
+        let targets: Vec<_> = (0..=400)
+            .map(|tick| sweep.target(start + Duration::from_millis(tick * 20)))
+            .collect();
+        assert!(targets.iter().all(|target| (1991..=2105).contains(target)));
+        assert!(
+            targets
+                .windows(2)
+                .all(|pair| (pair[1] - pair[0]).abs() <= 1)
+        );
+    }
+    /// 使用真实 C ABI 空会话和模拟关节反馈验证停止/失联行为，不创建 Bus 或串口。
+    #[test]
+    #[ignore = "requires MICRODUCK_HEAD_CORE_TEST_LIB; run verify-native.sh"]
+    fn stopping_or_expired_page_freezes_only_the_test_joint_and_never_resumes() {
+        let library = std::env::var("MICRODUCK_HEAD_CORE_TEST_LIB").unwrap();
+        let calibration = Calibration::commissioning(JOINT_IDS);
+        let mut hold = Hold {
+            from: vec![2048; 15],
+            targets: vec![2048; 15],
+            directions: calibration
+                .joints
+                .iter()
+                .map(|joint| joint.direction)
+                .collect(),
+            started: Instant::now(),
+            duration: PREPARE_TIME,
+            stage: HoldStage::Holding,
+            reply: None,
+            last_written: Some(vec![2048; 15]),
+            max_error: 0,
+        };
+        let index = JOINT_IDS.iter().position(|id| *id == 30).unwrap();
+        let mut raw = [0u8; 15];
+        raw[..2].copy_from_slice(&2055u16.to_le_bytes());
+        let samples = [(30, ServoSample::decode(&raw).unwrap())]
+            .into_iter()
+            .collect();
+        for expired in [false, true] {
+            hold.targets.fill(2048);
+            let mut run = StandingCalibration::new(&library, &calibration, &hold).unwrap();
+            run.next_step = 6;
+            run.testing = true;
+            run.sweep = Some(Sweep {
+                index,
+                id: 30,
+                from: 2048,
+                center: 2048,
+                started: Instant::now(),
+            });
+            hold.targets[index] = 2070;
+            if expired {
+                run.heartbeat = Instant::now() - PAGE_LEASE - Duration::from_millis(1);
+                run.tick(Some(&mut hold), &samples, Instant::now());
+            } else {
+                run.pause(Some(&mut hold), &samples, "operator stop");
+            }
+            assert!(!run.running());
+            assert!(run.sweep.is_none());
+            assert_eq!(hold.targets[index], 2055);
+            assert!(
+                hold.targets
+                    .iter()
+                    .enumerate()
+                    .all(|(i, target)| i == index || *target == 2048)
+            );
+            let before = hold.targets.clone();
+            run.status().unwrap();
+            run.tick(
+                Some(&mut hold),
+                &samples,
+                Instant::now() + Duration::from_secs(1),
+            );
+            assert!(!run.running());
+            assert_eq!(hold.targets, before);
+            assert!(matches!(hold.stage, HoldStage::Holding));
+            assert!(run.resume(false).is_err());
+            run.resume(true).unwrap();
+            assert!(run.running() && run.sweep.is_none());
+            assert!(run.not_before > Instant::now());
+        }
+    }
+}
