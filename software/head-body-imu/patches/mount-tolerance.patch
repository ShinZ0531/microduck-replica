+    /// 保存路径的 TOML/JSON 浮点解析可能差一个 ULP；同安装必须接受，真换安装仍拒绝。
+    #[test]
+    fn proof_mount_tolerates_roundtrip_ulp_but_not_another_mount() {
+        let (calibration, mut proof) = fixture();
+        let mount = proof["mount"].as_array().unwrap().clone();
+        let mut changed = mount.clone();
+        changed[0] = serde_json::json!(f64::from_bits(mount[0].as_f64().unwrap().to_bits() ^ 1));
+        proof["mount"] = serde_json::Value::Array(changed);
+        let directory = std::env::temp_dir().join(format!(
+            "head-proof-ulp-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        std::fs::create_dir(&directory).unwrap();
+        let path = directory.join("calibration.toml");
+        save_proof(&path, &proof).unwrap();
+        assert!(verified_proof(&path, &calibration).is_some(), "one ULP is the same mount");
+        let half_degree = 0.5f64.to_radians() / 2.0;
+        let turned = [0.5 * half_degree.cos(), 0.5 * half_degree.cos(),
+                      0.5 * half_degree.cos(), 0.5 * half_degree.sin()];
+        proof["mount"] = serde_json::json!(turned);
+        save_proof(&path, &proof).unwrap();
+        assert!(verified_proof(&path, &calibration).is_none(), "a different mount is rejected");
+        std::fs::remove_dir_all(directory).unwrap();
+    }
