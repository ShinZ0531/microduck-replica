+/// 两个四元数是否表示同一安装；TOML 与 JSON 的浮点解析可能差 1 ULP，不能按位比较。
+fn quat_matches(left: &Value, right: &Value) -> bool {
+    let parse = |value: &Value| -> Option<[f64; 4]> {
+        let items = value.as_array()?;
+        if items.len() != 4 {
+            return None;
+        }
+        let mut quat = [0.0; 4];
+        for (index, item) in items.iter().enumerate() {
+            quat[index] = item.as_f64().filter(|number| number.is_finite())?;
+        }
+        let norm = (quat.iter().map(|number| number * number).sum::<f64>()).sqrt();
+        if !(0.9..=1.1).contains(&norm) {
+            return None;
+        }
+        for number in &mut quat {
+            *number /= norm;
+        }
+        Some(quat)
+    };
+    let (Some(left), Some(right)) = (parse(left), parse(right)) else {
+        return false;
+    };
+    let dot: f64 = (0..4).map(|index| left[index] * right[index]).sum();
+    dot.abs() >= 1.0 - 1e-6
+}
