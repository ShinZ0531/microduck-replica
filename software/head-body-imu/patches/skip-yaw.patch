+    /// 偏航跳过必须是步骤 8 的零证据明确标记；换到别步或丢掉方法标识都拒绝。
+    #[test]
+    fn skipped_yaw_is_an_explicit_zero_evidence_report() {
+        let (calibration, mut proof) = fixture();
+        let skip = json!({"step":8,"sample_count":0,"sample_span_s":0.0,
+            "max_body_error_deg":null,"body_gyro_rms_rad_s":null,"body_gyro_peak_rad_s":null,
+            "head_span_deg":null,"gyro_integral_error_ratio":null,"method":"skipped_yaw_v1",
+            "endpoint_count":0,"segment_count":0,"rate_quality":"not_measured","skipped":true});
+        proof["reports"][8] = skip.clone();
+        let directory = std::env::temp_dir().join(format!(
+            "head-proof-skip-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        std::fs::create_dir(&directory).unwrap();
+        let path = directory.join("calibration.toml");
+        save_proof(&path, &proof).unwrap();
+        assert!(verified_proof(&path, &calibration).is_some(), "explicit yaw skip accepted");
+        let mut wrong_step = proof.clone();
+        wrong_step["reports"][7] = skip.clone();
+        save_proof(&path, &wrong_step).unwrap();
+        assert!(verified_proof(&path, &calibration).is_none(), "skip only at the yaw step");
+        let mut no_marker = proof.clone();
+        no_marker["reports"][8]["skipped"] = json!(false);
+        save_proof(&path, &no_marker).unwrap();
+        assert!(verified_proof(&path, &calibration).is_none(), "skip needs the explicit marker");
+        std::fs::remove_dir_all(directory).unwrap();
+    }
