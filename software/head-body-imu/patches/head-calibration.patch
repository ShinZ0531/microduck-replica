+        if source != TrunkImuKind::HeadBmi088 {
+            return Err("当前不是头部 BMI088 来源".into());
+        }
+        if operation == "status" {
+            return session.as_mut().map_or_else(
+                || Ok(json!({"active":false,"contract":duck_control::head_calibration::CONTRACT})),
+                |session| {
+                    session.capture(0, false).map(|mut status| {
+                        status["active"] = json!(true);
+                        status
+                    })
+                },
+            );
+        }
+        if !confirmed {
+            return Err("请明确确认按当前步骤固定机身或头部；未保存".into());
+        }
+        if operation == "cancel" {
+            *session = None;
+            return Ok(json!({"active":false,"cancelled":true}));
+        }
+        if !safe {
+            return Err("头部校验需要十五颗舵机已断力、没有移动或其他标定任务".into());
+        }
+        if operation == "start" {
+            let created = duck_control::head_calibration::Session::new(
+                library.ok_or("未配置头部算法库")?,
+                calibration,
+            )?;
+            *session = Some(created);
+        } else if operation != "capture" && operation != "save" {
+            return Err("未知的头部校验操作".into());
+        }
+        let current = session.as_mut().ok_or("头部校验会话已结束，请重新开始")?;
+        if operation == "capture" {
+            return current.capture(step, true).map(|mut status| {
+                status["active"] = json!(true);
