+//! 头部 IMU 专用校验的 C++ 绑定；仅封装有界数据、会话与核验报告，不实现第二份几何算法。
+use std::ffi::{c_char, c_void};
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+
+use crate::feetech::Calibration;
+use crate::head_compensation::{EncoderPair, HeadCompensation, HeadInput};
+use crate::trunk_imu::{HostImuSample, TrunkImuKind};
+use serde_json::{Value, json};
+
+pub const CONTRACT: &str = "head_mount_fixed_torso_v1";
+
+/// 与独立校准 ABI 一致；现有估计 ABI v1 不改布局。
+#[repr(C)]
+struct Status {
+    version: u32,
+    step: u32,
+    count: u32,
+    available: u32,
+    mount: [f64; 4],
+    span: f64,
+    error_deg: f64,
+    gyro_rms: f64,
+    gyro_peak: f64,
+    head_span: f64,
+    reason: [c_char; 256],
+}
+
+type Create = unsafe extern "C" fn() -> *mut c_void;
+type Destroy = unsafe extern "C" fn(*mut c_void);
+type Observe = unsafe extern "C" fn(*mut c_void, *const HeadInput, *const EncoderPair) -> i32;
+type Capture = unsafe extern "C" fn(*mut c_void, u32, u32, *mut Status) -> i32;
+
+/// 绑定实际头部零位、方向及冻结模型；标志和 motion_enabled 不作为安装几何的一部分。
+pub fn binding(calibration: &Calibration) -> Value {
+    let joints: Vec<_> = calibration
+        .joints
+        .iter()
+        .filter(|joint| [30, 31, 32, 33].contains(&joint.id))
+        .map(|joint| {
+            json!({"id":joint.id,"name":joint.name,"zero_raw":joint.zero_raw,
+            "direction":joint.direction})
+        })
+        .collect();
+    json!({"model_sha256":"078693dff3bcd5e69eb6cc483974178e1511a11f762b1a4dd00370bc5d58b8a8",
+        "joints":joints})
+}
+
+/// 每个 commissioning 消费者独占一个会话；指针不共享给第二线程。
+pub struct Session {
+    _library: libloading::Library,
+    handle: *mut c_void,
+    destroy: Destroy,
+    observe: Observe,
+    capture: Capture,
+    binding: Value,
+    epoch: Option<u32>,
+    sequence: Option<u32>,
+    created: Instant,
+    last_sample: Option<Instant>,
+    reports: Vec<Value>,
+}
+
+// SAFETY: 会话可随控制任务在线程间移动，但所有访问均需 &mut self；C++ 句柄没有共享引用或后台线程。
+unsafe impl Send for Session {}
+
+impl Session {
+    /// 显式使用本地配置的算法库；旧库缺少新符号时拒绝，不伪装支持校准。
+    pub fn new(path: &str, calibration: &Calibration) -> Result<Self, String> {
+        let library =
+            unsafe { libloading::Library::new(path) }.map_err(|error| error.to_string())?;
+        let create = unsafe {
+            *library
+                .get::<Create>(b"microduck_head_calibration_create\0")
+                .map_err(|error| error.to_string())?
+        };
+        let destroy = unsafe {
+            *library
+                .get::<Destroy>(b"microduck_head_calibration_destroy\0")
+                .map_err(|error| error.to_string())?
+        };
+        let observe = unsafe {
+            *library
+                .get::<Observe>(b"microduck_head_calibration_observe\0")
+                .map_err(|error| error.to_string())?
+        };
+        let capture = unsafe {
+            *library
+                .get::<Capture>(b"microduck_head_calibration_capture\0")
+                .map_err(|error| error.to_string())?
+        };
+        let handle = unsafe { create() };
+        if handle.is_null() {
+            return Err("无法创建头部安装核验会话".into());
+        }
+        Ok(Self {
+            _library: library,
+            handle,
+            destroy,
+            observe,
+            capture,
+            binding: binding(calibration),
+            epoch: None,
+            sequence: None,
+            created: Instant::now(),
+            last_sample: None,
+            reports: Vec::new(),
+        })
+    }
+
+    /// 只接受真实 raw provider 与原有编码器历史；来源重启、几何改变或超时使整个会话失效。
+    pub fn observe(
+        &mut self,
+        head: &HeadCompensation,
+        sample: HostImuSample,
+        calibration: &Calibration,
+        now: Instant,
+    ) -> Result<(), String> {
+        if self.created.elapsed() > Duration::from_secs(600) || binding(calibration) != self.binding
+        {
+            return Err("校验会话超时或头部关节配置改变，请重新开始".into());
+        }
+        if self.epoch.is_some_and(|epoch| epoch != sample.epoch) {
+            return Err("头部 IMU 已重连，旧核验数据作废，请重新开始".into());
+        }
+        self.epoch = Some(sample.epoch);
+        if self.sequence == Some(sample.sequence) {
+            return Ok(());
+        }
+        self.sequence = Some(sample.sequence);
+        let Ok((mut input, pair)) = head.calibration_input(&sample, calibration, now) else {
+            self.last_sample = None;
+            return Ok(());
+        };
+        // 此处仅验证原始测量和关节范围；候选安装由 C++ 会话自己求解和应用。
+        input.sensor_to_site = [1.0, 0.0, 0.0, 0.0];
+        let code = unsafe { (self.observe)(self.handle, &input, &pair) };
+        self.last_sample = (code == 0).then_some(sample.received_at);
+        Ok(())
+    }
+
+    /// 保存前检查最后一份测量时效；查询、点击和旧报告都不能替代新鲜实测。
+    pub fn require_fresh(&self) -> Result<(), String> {
+        if self.created.elapsed() > Duration::from_secs(600)
+            || self
+                .last_sample
+                .is_none_or(|at| at.elapsed() > Duration::from_millis(100))
+        {
+            return Err("采样不新鲜或会话已超时，未保存".into());
+        }
+        Ok(())
+    }
+
+    /// 查询或采集下一步骤；失败保留当前步骤，成功结果包含实测误差与采样数量。
+    pub fn capture(&mut self, step: u32, capture: bool) -> Result<Value, String> {
+        if capture
+            && (self.created.elapsed() > Duration::from_secs(600)
+                || self
+                    .last_sample
+                    .is_none_or(|at| at.elapsed() > Duration::from_millis(100)))
+        {
+            return Err("头部采样不新鲜或会话超时，未推进核验".into());
+        }
+        // SAFETY: Status 只含 C POD，零填充同时保证错误文本有终止符。
+        let mut status: Status = unsafe { std::mem::zeroed() };
+        let result = unsafe { (self.capture)(self.handle, step, u32::from(capture), &mut status) };
+        if status.version != 1 || status.step > 10 {
+            return Err("头部校准 ABI 返回无效状态".into());
+        }
+        let row = json!({"step":step,"sample_count":status.count,"sample_span_s":status.span,
+            "max_body_error_deg":status.error_deg,"body_gyro_rms_rad_s":status.gyro_rms,
+            "body_gyro_peak_rad_s":status.gyro_peak,"head_span_deg":status.head_span});
+        if result != 0 {
+            let bytes: Vec<_> = status
+                .reason
+                .iter()
+                .take_while(|value| **value != 0)
+                .map(|value| *value as u8)
+                .collect();
+            return Err(format!(
+                "{}（{} 帧，躯干残差 {:.2}°，角速度 RMS {:.3}、峰值 {:.3} rad/s，关节行程 {:.1}°）",
+                String::from_utf8_lossy(&bytes),
+                status.count,
+                status.error_deg,
+                status.gyro_rms,
+                status.gyro_peak,
+                status.head_span
+            ));
+        }
+        if capture {
+            self.reports.push(row);
+        }
+        Ok(
+            json!({"contract":CONTRACT,"next_step":status.step,"ready_to_save":status.step==10,
+            "sample_count":status.count,"sample_span_s":status.span,
+            "mount":(status.available==1).then_some(status.mount),"reports":self.reports,
+            "binding":self.binding,"epoch":self.epoch}),
+        )
+    }
+}
+
+impl Drop for Session {
+    /// 在 Library 卸载之前释放 C++ 状态；无后台任务或设备副作用。
+    fn drop(&mut self) {
+        unsafe { (self.destroy)(self.handle) };
+    }
+}
+
+/// 核验报告与标定文件放在同一受保护目录，不进入通用发布配置。
+pub fn proof_path(path: &Path) -> PathBuf {
+    path.with_extension("head-imu-proof.json")
+}
+
+/// 检查报告的数据形状和已发布门限；报告本身只能由原生会话产生，不能由网页上传。
+fn valid_report(index: usize, report: &Value) -> bool {
+    let number = |key: &str| {
+        report
+            .get(key)
+            .and_then(Value::as_f64)
+            .filter(|value| value.is_finite())
+    };
+    let basic = report.get("step") == Some(&json!(index))
+        && report
+            .get("sample_count")
+            .and_then(Value::as_u64)
+            .is_some_and(|count| count >= 60)
+        && number("sample_span_s").is_some_and(|span| span >= 1.5);
+    if (4..=7).contains(&index) {
+        basic
+            && number("max_body_error_deg").is_some_and(|value| (0.0..=5.0).contains(&value))
+            && number("body_gyro_rms_rad_s").is_some_and(|value| (0.0..=0.15).contains(&value))
+            && number("body_gyro_peak_rad_s").is_some_and(|value| (0.0..=0.5).contains(&value))
+            && number("head_span_deg").is_some_and(|value| (8.0..=360.0).contains(&value))
+    } else {
+        basic
+    }
+}
+
+/// 只认可同一安装四元数、四个头颈关节配置及完整十步的本地主控报告。
+pub fn verified_proof(path: &Path, calibration: &Calibration) -> Option<Value> {
+    let proof: Value = serde_json::from_slice(&std::fs::read(proof_path(path)).ok()?).ok()?;
+    let mount = calibration.imu_mount(TrunkImuKind::HeadBmi088);
+    let reports = proof.get("reports")?.as_array()?;
+    if !mount.verified
+        || proof.get("contract")? != CONTRACT
+        || proof.get("source")? != "head_bmi088"
+        || proof.get("binding")? != &binding(calibration)
+        || proof.get("mount")? != &json!(mount.quat)
+        || reports.len() != 10
+        || reports
+            .iter()
+            .enumerate()
+            .any(|(index, report)| !valid_report(index, report))
+    {
+        return None;
+    }
+    Some(proof)
+}
+
+/// 原子保存有界主控报告；先保存报告再保存 verified，避免无报告的半次成功。
+pub fn save_proof(path: &Path, proof: &Value) -> Result<(), String> {
+    use std::io::Write;
+    let destination = proof_path(path);
+    let temporary = destination.with_extension("json.tmp");
+    let data = serde_json::to_vec_pretty(proof).map_err(|error| error.to_string())?;
+    let mut file = std::fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&temporary)
+        .map_err(|error| error.to_string())?;
+    let result = (|| {
+        file.write_all(&data)?;
+        file.sync_all()?;
+        std::fs::rename(&temporary, &destination)
+    })();
+    if result.is_err() {
+        let _ = std::fs::remove_file(&temporary);
+    }
+    result.map_err(|error| error.to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::feetech::ImuMount;
+
+    /// 只构造受保护文件形状的合成报告，不宣称是物理安装证明。
+    fn fixture() -> (Calibration, Value) {
+        let mut calibration = Calibration::commissioning(crate::model::JOINT_IDS);
+        calibration.set_imu_mount(
+            TrunkImuKind::HeadBmi088,
+            ImuMount {
+                quat: [0.5, 0.5, 0.5, 0.5],
+                verified: true,
+            },
+        );
+        let reports: Vec<_> = (0..10)
+            .map(|step| {
+                json!({"step":step,"sample_count":100,
+            "sample_span_s":1.98,"max_body_error_deg":0.1,"body_gyro_rms_rad_s":0.01,"body_gyro_peak_rad_s":0.02,
+            "head_span_deg":10.0})
+            })
+            .collect();
+        let proof = json!({"contract":CONTRACT,"source":"head_bmi088",
+            "mount":[0.5,0.5,0.5,0.5],"binding":binding(&calibration),"reports":reports});
+        (calibration, proof)
+    }
+
+    /// 报告必须匹配实际关节配置和安装；写入运动开关本身不改变安装几何绑定。
+    #[test]
+    fn proof_is_bound_to_head_geometry_not_motion_switch() {
+        let (mut calibration, proof) = fixture();
+        let directory = std::env::temp_dir().join(format!(
+            "head-proof-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        std::fs::create_dir(&directory).unwrap();
+        let path = directory.join("calibration.toml");
+        assert!(verified_proof(&path, &calibration).is_none());
+        save_proof(&path, &proof).unwrap();
+        assert!(verified_proof(&path, &calibration).is_some());
+        calibration.motion_enabled = true;
+        assert!(verified_proof(&path, &calibration).is_some());
+        calibration
+            .joints
+            .iter_mut()
+            .find(|joint| joint.id == 31)
+            .unwrap()
+            .zero_raw += 1;
+        assert!(verified_proof(&path, &calibration).is_none());
+        std::fs::remove_dir_all(directory).unwrap();
+    }
+
+    /// 真实库有独立校准 ABI，但创建会话、查询或伪造步号不能替代真实采样。
+    #[test]
+    #[ignore = "requires MICRODUCK_HEAD_CORE_TEST_LIB; run verify-native.sh"]
+    fn real_library_does_not_certify_empty_session() {
+        let path = std::env::var("MICRODUCK_HEAD_CORE_TEST_LIB").unwrap();
+        let (calibration, _) = fixture();
+        let mut session = Session::new(&path, &calibration).unwrap();
+        assert!(session.require_fresh().is_err());
+        assert!(session.capture(0, true).is_err());
+        assert!(session.capture(9, true).is_err());
+        let status = session.capture(0, false).unwrap();
+        assert_eq!(status["next_step"], 0);
+        assert_eq!(status["ready_to_save"], false);
+        assert_eq!(status["mount"], Value::Null);
+        assert_eq!(status["reports"], json!([]));
+        assert_eq!(std::mem::size_of::<Status>(), 344);
+    }
+}
