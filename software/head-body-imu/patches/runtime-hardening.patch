@@ -0,0 +1,43 @@
+# 只用于原生恢复动作回归；独立于当前发布包的踢腿/滑轮按键设置，不部署到设备。
+[bus]
+port = "/dev/ttyS2"
+protocol = "feetech"
+
+[control]
+hz = 50
+
+[policy]
+enabled = true
+custom_only = true
+mode = "walk"
+walk = "/opt/robot/feetech-ft5-r5/models/1cbf8730eadd75a5704332c9f3c10f60/policy.onnx"
+stand = "none"
+sitstand = "none"
+ground_pick = "none"
+kick_left = "none"
+kick_right = "none"
+roulade = "none"
+gain = 5
+action_scale = 0.7
+standing_action_scale = 1.0
+
+[[policy.skill]]
+name = "stand_test"
+path = "/unused-test-model/stand/policy.onnx"
+# 六秒为人工测试窗口；测试调用方替换成原始 stand 导出模型的本地路径。
+duration = 6.0
+chain = false
+command = [0.0, 0.0, 0.0]
+unwind = [0.0, 0.0, 0.0]
+unwind_s = 0.0
+
+[policy.skill.params]
+action_scale = 1.0
+gain_ratio = 1.0
+
+[pad]
+lb = "stand_test"
+
+[safety]
+limp_fall = false
+battery_empty_shutdown = false
